#
# This example production configuration file is used during turbo-config package developmen
# it is commited to SCM for learning purposes only
#
# these values need to be set as environment variables in whatever hosting service you use
# for your application, these values should never be commited to source control
#
# if you need to share these values with others, find a secure way to do so
#

# server values for running on "render.com"
# thses enntries are automatically set on render.com
## they are here for instructional purposes only
HOST=0.0.0.0
PORT=10000

# database
DB_HOST=https://postgres-hosting.com
DB_PORT=5432
DB_USERNAME=secret_username_for_production
DB_PASSWORD=secret_password_for_production
